SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
DEEZER_ARL=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
# Application access policy: none = current behavior, admin = require admin sign-in before use.
GHARMONIZE_ACCESS_MODE=none
# When admin mode is active, allow clients to request temporary use from a signed-in administrator.
GHARMONIZE_TEMP_ACCESS_ENABLED=0
GHARMONIZE_TEMP_ACCESS_HOURS=1
GHARMONIZE_TEMP_ACCESS_DAYS=0
GHARMONIZE_TEMP_ACCESS_MONTHS=0
GHARMONIZE_TEMP_ACCESS_YEARS=0
PREVIEW_MAX_ENTRIES=1000
AUTOMIX_ALL_TIMEOUT_MS=60000
AUTOMIX_PAGE_TIMEOUT_MS=60000
PLAYLIST_ALL_TIMEOUT_MS=35000
PLAYLIST_PAGE_TIMEOUT_MS=25000
PLAYLIST_META_TIMEOUT_MS=15000
PLAYLIST_META_FALLBACK_TIMEOUT_MS=15000
YTDLP_BIN=
YTDLP_EXTRA=
YTDLP_ARGS_EXTRA=
YTDLP_AUDIO_LIMIT_RATE=999999500K
PREVIEW_CACHE_TTL_MS=1800000
UPLOAD_MAX_BYTES=2500mb
TRACK_EXTRACTOR_SHELL_INTEGRATION=1
LOCAL_INPUT_DIR=
SPOTIFY_MARKET=US
SPOTIFY_FALLBACK_MARKETS=GB,DE,FR
SPOTIFY_DEBUG_MARKET=0
PREFER_SPOTIFY_TAGS=1
TITLE_CLEAN_PIPE=1
CLEAN_SUFFIXES=topic,official
CLEAN_PHRASES="official channel,Official Video"
CLEAN_PARENS=official,topic
YT_STRIP_COOKIES=0
YTDLP_COOKIES=
YTDLP_COOKIES_FROM_BROWSER=
YT_UI_FORCE_COOKIES=0
YT_LANG=en-US
# YouTube Music account index for browser-cookie auth (0, 1, 2...). Leave blank for default account.
YTM_AUTH_USER=
# Shared YouTube Music server cache and upstream API pacing.
YTM_SHARED_CACHE_PERSIST=1
YTM_HOME_RESULT_CACHE_TTL_MS=600000
YOUTUBE_DISCOVER_CACHE_TTL_MS=900000
YTM_API_MIN_INTERVAL_MS=500
YTM_PARTIAL_RETRY_DELAY_MS=5000
YT_FORCE_IPV4=1
YT_ACCEPT_LANGUAGE=en;q=0.8
YT_DEFAULT_REGION=US
ENRICH_SPOTIFY_FOR_YT=1
YT_403_WORKAROUNDS=0
YT_USE_MUSIC=1
YTDLP_UA="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/127.0.0.0 Safari/537.36"
MEDIA_COMMENT=Gharmonize
FFMPEG_BIN=
PUID=1000
PGID=1000
YT_SEARCH_RESULTS=3
YT_SEARCH_TIMEOUT_MS=25000
YT_SEARCH_STAGGER_MS=180
HOMEPAGE_WIDGET_KEY=
GHARMONIZE_WEB_BINARIES_IN_DOCKER=1
GHARMONIZE_FFMPEG_CHANNEL=stable
TRUST_PROXY=0
YOUTUBE_QUICK_ADD_LIMIT=50
YOUTUBE_DISCOVER_DEBUG=0
YTLIVE_MUSIC_TITLE="Gharmonize Music"
YTLIVE_MUSIC_SUBTITLE="Youtube Live"

GHARMONIZE_HOST=127.0.0.1
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
GHARMONIZE_ALLOW_PRIVATE_URLS=0
GHARMONIZE_ALLOW_UNSAFE_YTDLP_ARGS=0
GHARMONIZE_MASTER_KEY_FILE=
GHARMONIZE_INITIAL_ADMIN_PASSWORD_FILE=
